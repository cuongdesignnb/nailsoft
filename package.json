{
  "name": "nailsoft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run && playwright test",
    "test:unit": "pnpm --filter @nailsoft/config build && pnpm --filter @nailsoft/domain-types build && pnpm --filter @nailsoft/validation build && vitest run packages apps/api/test apps/worker tests/mobile",
    "test:integration": "pnpm --filter @nailsoft/domain-types build && pnpm --filter @nailsoft/validation build && node scripts/run-integration-tests.mjs",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "load:smoke": "node scripts/load-smoke.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:integrity": "node scripts/integrity-check.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:evidence": "node scripts/supply-chain-audit.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.2",
    "@types/node": "^20.19.1",
    "@types/pg": "^8.15.4",
    "eslint": "^9.29.0",
    "pg": "^8.16.0",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  }
}
